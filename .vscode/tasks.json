{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Current C++ File",
      "type": "shell",
      "command": "cmd /c \"cd /d ${fileDirname} && C:\\msys64\\ucrt64\\bin\\g++.exe ${file} -o ${fileDirname}\\${fileBasenameNoExtension}.exe && ${fileDirname}\\${fileBasenameNoExtension}.exe `< input.txt `> output.txt\"",
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
